h1.govuk-heading-l Users
= render partial: "shared/flash_messages", flash: flash
#admin-users-list
  div
    / Invitations are a password-setting flow, so the routes only exist while
    / PASSWORD_LOGIN_ENABLED is on. With OAuth, users are provisioned
    / automatically on their first sign in and there is nobody to invite —
    / rendering the link unconditionally raised on the missing helper.
    - if Settings.password_login_enabled?
      ul#admin-button-bar
        li= link_to 'Invite new user', new_user_invitation_path, {class: 'button-secondary'}
  table.table aria-label="users"
    thead
      tr
        th Name
        th Role
        th Last Sign in
        th Status
    tbody
      - @users.each do |user|
        tr
          td= link_to user.name, user_path(user)
          td= link_to user.roles, user_path(user)
          td
            - if user.current_sign_in_at.nil?
              | never active
            - else
              = time_ago_in_words(user.current_sign_in_at) unless user.current_sign_in_at.nil?
          td= render partial: 'shared/status', object: user
          td.edit= link_to 'Edit', edit_user_path(user)
