###
### These environment variables are defined as dummy variables to ensure the build packages correctly.
### They will never get used in production environments
###
DEVISE_SECRET=eed7c257fbffd3229ab2e32069c364084ddcfef3db7f902b43012a5bf03c8713be0cb3b484c48f658ddcad37393777fa4ba3dcc68fde32f684c0d4ebd03832d2
DEVISE_SENDER=no-reply@digital.justice.gov.uk
GOVUK_NOTIFY_API_KEY=notify-api-key
PQ_REST_API_HOST=http://localhost:8888
# Because we need to set env to "production" to generate assets, we need to set these two as wel
PQ_REST_API_USERNAME=dummy
PQ_REST_API_PASSWORD=dummy
DB_USERNAME=postgres
DB_PASSWORD=
# Shared secret required on the /deploy_info endpoint, checked against the
# header sent by cdpt-deploys-dashboard
DEPLOY_DASHBOARD_SHARED_SECRET=
#
# Authentication. Localhost needs no Azure credentials: the OmniAuth developer
# strategy is registered in the development environment only and gives you a
# local form that exercises the whole callback path — claim validation,
# identity resolution, provisioning and sign-in — without a secret on your
# machine.
#
# Fill these three in only if you want the real Azure round trip locally; the
# http://localhost:3000 redirect URI is already registered. Leaving them empty
# is safe here because the boot-time credential check only applies when
# RAILS_ENV is production.
OMNIAUTH_AZURE_TENANT_ID=
OMNIAUTH_AZURE_CLIENT_ID=
OMNIAUTH_AZURE_CLIENT_SECRET=
# Both default as shown, so these lines only document them. Set
# PASSWORD_LOGIN_ENABLED=true to get the email/password form back; it needs a
# restart, because routes are drawn at boot.
OAUTH_AZURE_ENABLED=true
PASSWORD_LOGIN_ENABLED=false
