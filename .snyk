# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.5.0
ignore:
  SNYK-JS-BRACES-19963945:
    - '*':
        reason: >-
          Uncontrolled Recursion in braces@3.0.3, pulled in transitively via
          sass > @parcel/watcher > micromatch > braces. No upgrade or patch
          is available upstream. @parcel/watcher is sass's optional native
          file-watcher, only used in `sass --watch` mode; this project only
          runs sass as a one-shot compile (yarn build:css), so the vulnerable
          code path is not exercised. Revisit when a fixed braces or
          @parcel/watcher release is published.
        expires: 2027-03-23T00:00:00.000Z